{
  "name": "quest-of-fortune",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "math": "vite build --config vite.math.config.ts && node .math-dist/math-simulator.mjs",
    "math:quick": "vite build --config vite.math.config.ts && node .math-dist/math-simulator.mjs --quick",
    "math:input": "vite build --config vite.math.config.ts && node .math-dist/math-simulator.mjs --input",
    "math:quick:input": "vite build --config vite.math.config.ts && node .math-dist/math-simulator.mjs --quick --input",
    "reels:generate": "vite build --config vite.reels.generate.config.ts && node .reel-dist/reel-sequence-optimizer.mjs",
    "reels:audit": "vite build --config vite.reels.audit.config.ts && node .reel-audit-dist/reel-audit.mjs"
  },
  "devDependencies": {
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "gsap": "^3.15.0",
    "pixi.js": "^8.20.1"
  }
}
